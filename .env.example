# ===========================================
# Spam KP Assistant — Конфигурация (.env)
# ===========================================
# 
# 🔐 ВАЖНО О БЕЗОПАСНОСТИ:
# ===========================================
# 1. Этот файл (.env.example) — ШАБЛОН. Не содержит секретов.
# 2. Скопируйте его в .env и заполните своими данными.
# 3. Файл .env НЕ КОММИТИТСЯ в Git (добавлен в .gitignore).
# 
# ⚠️ ПАРОЛИ SMTP/IMAP:
# -------------------------------------------
# Пароли НЕ хранятся в этом файле!
# Они вводятся через GUI: Настройки → SMTP аккаунты
# и сохраняются в зашифрованном виде в базе данных (SQLite).
# Ключ шифрования автоматически создаётся и хранится в
# Windows Credential Manager (защита на уровне ОС).
# 
# 🔑 API КЛЮЧИ:
# -------------------------------------------
# API ключи (ProxyAPI и др.) хранятся в .env локально.
# Не коммитьте .env в Git!
# 
# ===========================================

# -------------------------------------------
# LLM (ProxyAPI)
# -------------------------------------------
# Получите ключ на: https://console.proxyapi.ru/
PROXYAPI_API_KEY=your_api_key_here

# Модели LLM
PROXYAPI_PRIMARY_MODEL=gpt-5.4-mini
PROXYAPI_FALLBACK_MODEL=gpt-5.3-chat-latest
PROXYAPI_PARSING_MODEL=gemini-3.1-flash-lite

# -------------------------------------------
# Почта (SMTP/IMAP)
# -------------------------------------------
# Yandex: smtp.yandex.ru:587, imap.yandex.ru:993
# Gmail: smtp.gmail.com:587, imap.gmail.com:993
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USE_TLS=true

IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
IMAP_USE_SSL=true

# -------------------------------------------
# Логирование
# -------------------------------------------
# Уровни: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -------------------------------------------
# Приложение
# -------------------------------------------
# Окно приложения (пиксели)
WINDOW_WIDTH=1200
WINDOW_HEIGHT=800

# -------------------------------------------
# База данных
# -------------------------------------------
# SQLite (по умолчанию)
DATABASE_URL=sqlite:///data/spam_kp_assistant.db

# -------------------------------------------
# Шифрование
# -------------------------------------------
# Ключ шифрования для паролей (генерируется автоматически)
# Хранится в Windows Credential Manager
